{
  "name": "civicconnect",
  "version": "0.1.0",
  "private": true,
  "description": "CivicConnect frontend and backend monorepo.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "backend:dev": "npm run dev --workspace civicconnect-backend",
    "backend:start": "npm run start --workspace civicconnect-backend",
    "backend:seed": "npm run seed --workspace civicconnect-backend",
    "lint": "eslint frontend backend",
    "lint:fix": "eslint frontend backend --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
