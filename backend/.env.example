# ───────── CivicConnect backend config ─────────
# Fill in the three values marked  <<< FILL ME  and you're good to go.

PORT=5000
NODE_ENV=development

# Front-end origin(s) allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# ── MongoDB (Atlas cluster connection string) ──
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicconnect?retryWrites=true&w=majority
MONGODB_URI=

# ── ImageKit (Dashboard → Developer options → API keys) ──
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/civicconnect/complaints

# ── Auth ──
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated email addresses that receive the admin role at registration
ADMIN_EMAILS=admin@example.com

# Set true only when you want to generate the sample workers and reports
SEED_DEMO_DATA=false
