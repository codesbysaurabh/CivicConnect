# ───────── CivicConnect backend config ─────────
# Fill in the three values marked  <<< FILL ME  and you're good to go.

PORT=5000
NODE_ENV=development

# Front-end origin(s) allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# ── MongoDB (Atlas cluster connection string) ──
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicconnect?retryWrites=true&w=majority
MONGODB_URI=

# ── ImageKit (Dashboard → Developer options → API keys) ──
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/civicconnect/complaints

# ── Auth ──
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Phone numbers (10 digits, comma separated) that get the admin role on login
ADMIN_PHONES=9999999999

# ── OTP ──
# console = print the OTP in the server terminal (dev). Plug in an SMS provider in src/utils/otp.js for production.
OTP_MODE=console
# Dev only: if set, this code always works (ignored when NODE_ENV=production)
DEV_FIXED_OTP=1234
OTP_TTL_MINUTES=5
